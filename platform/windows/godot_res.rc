#include "core/version.h"

#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif

GODOT_ICON ICON platform/windows/godot.ico
1 RT_MANIFEST "platform/windows/godot.manifest"

1 VERSIONINFO
FILEVERSION     GODOT_VERSION_MAJOR,GODOT_VERSION_MINOR,GODOT_VERSION_PATCH,0
PRODUCTVERSION  GODOT_VERSION_MAJOR,GODOT_VERSION_MINOR,GODOT_VERSION_PATCH,0
FILEOS          4
FILETYPE        1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",            "Shakil / Game Master"
            VALUE "FileDescription",        "Game Master Engine Editor"
            VALUE "FileVersion",            GODOT_VERSION_NUMBER
            VALUE "InternalName",           "game_master"
            VALUE "OriginalFilename",       "game_master.exe"
            VALUE "ProductName",            "Game Master Engine"
            VALUE "Licence",                "MIT"
            VALUE "LegalCopyright",         "Copyright (c) Shakil. Game Master Engine is built upon the Godot Engine core."
            VALUE "Info",                   "https://gamemasterengine.com"
            VALUE "ProductVersion",         GODOT_VERSION_FULL_BUILD
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
